# ============================================================
# BaccaratLive TG — bot/.env.example
# 이 파일을 bot/.env 로 복사한 뒤 값을 채우세요.
# Bot Token은 절대 GitHub에 커밋하지 마세요.
# ============================================================

NODE_ENV=development

# Telegram Bot Token (@BotFather 발급)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Mini App URL (@BotFather /newapp 등록 주소)
MINI_APP_URL=https://t.me/your_bot/app

# 관리자 명령어 허용 Telegram ID (쉼표 구분)
ADMIN_TELEGRAM_IDS=

# 충전 안내에 표시할 플랫폼 지갑
PLATFORM_WALLET_ADDRESS=
PLATFORM_WALLET_NETWORK=TRC-20
