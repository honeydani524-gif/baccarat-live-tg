# ============================================================
# BaccaratLive TG — Monorepo .gitignore
# ⚠️ .env 파일은 절대 GitHub에 올리지 마세요. (.env.example만 허용)
# ============================================================

# Dependencies
node_modules/
**/node_modules/

# Environment variables — 실제 시크릿 금지
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Firebase / Service Accounts
serviceAccountKey.json
firebase-service-account.json
serviceAccount*.json
firebase-adminsdk-*.json
*-firebase-adminsdk-*.json
**/serviceAccount*.json
*.pem
*.key

# Build files
dist/
build/
**/dist/
**/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Coverage
coverage/
**/coverage/

# Temporary files
.tmp/
temp/
*.tmp
