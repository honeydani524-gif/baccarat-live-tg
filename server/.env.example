# ============================================================
# BaccaratLive TG — server/.env.example
# 이 파일을 server/.env 로 복사한 뒤 값을 채우세요.
# 실제 Secret/Token은 절대 GitHub에 커밋하지 마세요.
# ============================================================

NODE_ENV=development

# HTTP 포트
PORT=4000

# JWT 서명 키 (production 필수 — 충분히 긴 랜덤 문자열)
JWT_SECRET=your_jwt_secret_here

# 허용 CORS Origin (쉼표로 구분)
CORS_ORIGIN=http://localhost:5173

# Telegram initData 검증용 Bot Token / Secret
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_SECRET=

# 최초 SUPER_ADMIN 시딩용 Telegram ID (쉼표 구분)
ADMIN_TELEGRAM_IDS=

# 개발 모드: {dev:true} 로그인 및 dev-token 허용 (production에서 자동 무효)
DEV_AUTH_BYPASS=true

# 개발 모드: Socket.io 목업 게임 라운드 엔진
MOCK_GAME_ENGINE=true

# 로그 레벨: debug | info | warn | error
LOG_LEVEL=debug

# Firebase Admin — 서비스 계정 JSON을 "한 줄" 문자열로 입력
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_DATABASE_URL=

# 사업 설정 — 플랫폼 입금 지갑 (충전 안내에 표시)
PLATFORM_WALLET_ADDRESS=
PLATFORM_WALLET_NETWORK=TRC-20

# 스테이킹 최소/최대 (micro-USDT, 1 USDT = 1,000,000)
MIN_STAKE_AMOUNT=100000000
MAX_STAKE_AMOUNT=5000000000
